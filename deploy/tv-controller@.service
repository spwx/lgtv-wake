# Installed by `lgtv-wake setup` to ~/.config/systemd/user/.
# Started by the udev rule (90-lgtv-wake.rules) for each controller, keyboard and mouse event
# device; the process exits on its own when the device disconnects.
[Unit]
Description=LG TV wake for input device %i

[Service]
ExecStart=%h/.local/bin/lgtv-wake watch /dev/input/%i
Restart=no

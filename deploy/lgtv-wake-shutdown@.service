# Installed by `lgtv-wake setup` to /etc/systemd/system/ and enabled as
# lgtv-wake-shutdown@<user>.service. When the system powers off (not when it reboots),
# disconnects the Xbox controllers and turns the TV off if it's on lgtv-wake's input, running
# `lgtv-wake system-off` as <user>.
[Unit]
Description=Disconnect controllers and turn the LG TV off at power-off (lgtv-wake for %i)
# Units stop in reverse order at shutdown, so ExecStop runs while the network, D-Bus (for
# `systemctl list-jobs`) and bluetoothd (for `bluetoothctl disconnect`) are still up.
After=network.target NetworkManager.service dbus.service bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=%i
ExecStart=/usr/bin/true
ExecStop=/bin/sh -c 'XDG_RUNTIME_DIR=/run/user/$$(id -u) exec "$$HOME/.local/bin/lgtv-wake" system-off'
TimeoutStopSec=10
SyslogIdentifier=lgtv-wake

[Install]
WantedBy=multi-user.target
